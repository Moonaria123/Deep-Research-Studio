{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Research Studio",
  "version": "1.1.0-alpha.3",
  "identifier": "app.deepresearch.studio.gen1",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --mode desktop",
      "cwd": "../../web"
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build:desktop",
      "cwd": "../../web"
    },
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18789 ipc: http://ipc.localhost; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/deepresearch-api"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
